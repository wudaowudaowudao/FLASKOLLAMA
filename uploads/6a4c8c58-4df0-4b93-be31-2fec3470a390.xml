<SpecificationCheck>
    <CheckGroup Name="技术制图比例检查" DocType="Standard">
        <RuleItem Name="比例系列" CheckFun="ScaleCheck_1" RepairFun="" Description="本标准规定了绘图比例及其标注方法，适用于技术图样及有关技术文件。" ErrorType="错误/" ReviseSuggestion="" Type="">
            <CheckConfig>
                <Rule Name="原值比例" VerType="-" Value="1:1"/>
                <Rule Name="放大比例" VerType="-" Value="2:1, 5:1, 10:1, 20:1, 50:1"/>
                <Rule Name="缩小比例" VerType="-" Value="1:2, 1:5, 1:10, 1:20, 1:50"/>
            </CheckConfig>
        </RuleItem>
        <RuleItem Name="比例标注方法" CheckFun="MarkingCheck_1" RepairFun="" Description="比例符号应以“:”表示，并按规定位置标注比例，必要时允许在同一视图中的铅垂和水平方向标注不同的比例。" ErrorType="错误/警告" ReviseSuggestion="" Type="">
            <CheckConfig>
                <Rule Name="比例符号" VerType="-" Value=":"/>
                <Rule Name="标注位置" VerType="-" Value="标题栏中的比例栏内"/>
                <Rule Name="特殊标注" VerType="-" Value="视图名称的下方或右侧"/>
            </CheckConfig>
        </RuleItem>
        <RuleItem Name="比例尺形式" CheckFun="ScaleCheck_2" RepairFun="" Description="必要时，图样的比例可采用比例尺的形式，一般可在图样中的铅垂或水平方向加画比例尺。" ErrorType="错误/警告" ReviseSuggestion="" Type="">
            <CheckConfig>
                <Rule Name="比例尺方向" VerType="-" Value="铅垂或水平方向"/>
            </CheckConfig>
        </RuleItem>
    </CheckGroup>
</SpecificationCheck>
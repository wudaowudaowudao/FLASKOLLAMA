<SpecificationCheck>
    <CheckGroup Name="技术制图比例检查" DocType="Standard">
        <RuleItem Name="比例系列" CheckFun="ScaleCheck_1" RepairFun="" Description="本标准规定了绘图比例及其标注方法，适用于技术图样及有关技术文件。" ErrorType="错误/" ReviseSuggestion="" Type="">
            <CheckConfig>
                <Rule Name="原值比例" VerType="-" Value="1:1"/>
                <Rule Name="放大比例" VerType="-" Value="5:1, 2:1, 5X10:1, 2X10:1, 1×10:1, 4:1, 2.5:1, 4X10:1, 2.5×10:1"/>
                <Rule Name="缩小比例" VerType="-" Value="1:2, 1:5, 1:10, 1:1.5, 1:2.5, 1:1.5×10, 1:2.5X10, 1:3, 1:3×10, 1:4, 1:4×10, 1:6, 1:6×10"/>
            </CheckConfig>
        </RuleItem>
        <RuleItem Name="比例标注方法" CheckFun="MarkingCheck_1" RepairFun="" Description="比例符号应以“:”表示，并按规定位置标注比例，必要时允许在同一视图中的铅垂和水平方向标注不同的比例。" ErrorType="错误/警告" ReviseSuggestion="" Type="">
            <CheckConfig>
                <Rule Name="比例符号" VerType="-" Value=":"/>
                <Rule Name="标注位置" VerType="-" Value="标题栏中的比例栏内"/>
                <Rule Name="视图标注" VerType="-" Value="视图名称的下方或右侧"/>
                <Rule Name="不同方向比例" VerType="-" Value="铅垂方向1:1 000, 水平方向1:2 000"/>
                <Rule Name="比例尺形式" VerType="-" Value="在图样中的铅垂或水平方向加画比例尺"/>
            </CheckConfig>
        </RuleItem>
    </CheckGroup>
</SpecificationCheck>
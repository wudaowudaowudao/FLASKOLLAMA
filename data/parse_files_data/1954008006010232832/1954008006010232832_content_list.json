        ],
        "table_body": "\n\n<html><body><table><tr><td>01.1.5 01.1.6</td><td colspan=\"3\">剖面线 01.1</td></tr><tr><td></td><td colspan=\"3\">重合断面的轮廓线 01.1</td></tr><tr><td>01.1.7</td><td colspan=\"3\">短中心线 01.1</td></tr><tr><td>01.1.8</td><td colspan=\"3\">螺纹牙底线 01.1 01.1 HAIA</td></tr><tr><td>01.1.9</td><td colspan=\"3\">尺寸线的起止线 01.1 30</td></tr><tr><td>01.1.10</td><td colspan=\"3\">表示平面的对角线 01.1 01.1</td></tr><tr><td>01.1.11</td><td colspan=\"3\">零件成形前的弯折线</td></tr><tr><td></td><td colspan=\"3\">展开 1</td></tr><tr><td></td><td colspan=\"3\">01.1</td></tr><tr><td></td><td colspan=\"3\"></td></tr></table></body></html>\n\n",

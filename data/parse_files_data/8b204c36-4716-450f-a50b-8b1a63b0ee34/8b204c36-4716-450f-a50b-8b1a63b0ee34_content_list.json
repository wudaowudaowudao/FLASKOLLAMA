        "type": "table",
        "img_path": "/home/crrc/PycharmProjects/FlaskOllama/data/parse_files_data/8b204c36-4716-450f-a50b-8b1a63b0ee34/809df5a71a30424e28e94df18872c21f84f98b9c8c5dc64e774cae09b06c9952.jpg",
        "table_caption": [],
